{
  "name": "wurenche-regulatory-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm --filter api test",
    "test:api": "node tests/api/phase7-api.cjs && node tests/api/phase8-dashboard-api.cjs && node tests/api/enterprise-accounts-api.cjs && node tests/api/system-catalog-api.cjs",
    "test:api:accounts": "node tests/api/enterprise-accounts-api.cjs",
    "test:api:catalog": "node tests/api/system-catalog-api.cjs",
    "test:api:phase8": "node tests/api/phase8-dashboard-api.cjs",
    "test:db": "node tests/database/phase7-db.cjs",
    "test:e2e": "node tests/run-e2e.cjs",
    "test:e2e:phase7": "node tests/e2e/phase7.cjs",
    "test:e2e:phase8": "node tests/e2e/phase8.cjs",
    "test:e2e:admission": "node tests/e2e/admission-permits.cjs",
    "test:e2e:cockpit": "node tests/e2e/cockpit.cjs",
    "test:e2e:accounts": "node tests/e2e/enterprise-accounts.cjs",
    "test:e2e:catalog": "node tests/e2e/system-catalog.cjs",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --name init --schema prisma/schema.prisma",
    "db:migrate:phase2": "prisma migrate dev --name phase2_archives --schema prisma/schema.prisma",
    "db:migrate:phase3": "prisma migrate dev --name phase3_admission --schema prisma/schema.prisma",
    "db:migrate:phase4": "prisma migrate dev --name phase4_operations --schema prisma/schema.prisma",
    "db:migrate:phase5": "prisma migrate dev --name phase5_safety --schema prisma/schema.prisma",
    "db:migrate:phase6": "prisma migrate dev --name phase6_analytics --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed-shandong.ts",
    "db:seed:cockpit": "tsx prisma/seed-cockpit.ts",
    "db:seed:cockpit-digital": "tsx prisma/seed-cockpit-digital.ts",
    "db:seed:vehicle-types": "tsx prisma/seed-vehicle-types.ts",
    "db:geo": "tsx prisma/fetch-amap-geo.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:shandong": "tsx prisma/migrate-shandong.ts && tsx prisma/enrich-shandong.ts",
    "test:api:saas": "node tests/api/provincial-saas-api.cjs",
    "test:api:oversight": "node tests/api/navigation-oversight-api.cjs",
    "test:api:agents": "node tests/api/agent-center-api.cjs",
    "test:e2e:agents": "node tests/e2e/agent-center.cjs",
    "test:api:province-cockpit": "node tests/api/province-cockpit-api.cjs",
    "test:api:province-map": "node tests/api/province-map-api.cjs",
    "test:e2e:province-cockpit": "node tests/e2e/province-cockpit.cjs",
    "test:api:province-appearance": "node tests/api/province-appearance-api.cjs",
    "test:e2e:province-appearance": "node tests/e2e/province-appearance.cjs",
    "test:e2e:province-map-appearance": "node tests/e2e/province-map-appearance.cjs",
    "test:e2e:province-map-loading": "node tests/e2e/province-map-loading.cjs",
    "test:e2e:province-map-drill": "node tests/e2e/province-map-drill.cjs",
    "test:e2e:city-vehicle-popup": "node tests/e2e/city-vehicle-popup.cjs",
    "test:e2e:navigation": "node tests/e2e/province-menu-regression.cjs && node tests/e2e/city-enterprise-top-navigation.cjs && node tests/e2e/navigation-province.cjs && node tests/e2e/navigation-city-enterprise.cjs",
    "db:seed:oversight": "tsx prisma/seed-oversight.ts",
    "db:seed:applications": "tsx prisma/seed-city-applications.ts",
    "test:e2e:reports": "node tests/e2e/regulatory-reports.cjs",
    "test:e2e:province-analysis": "node tests/e2e/province-analysis.cjs",
    "test:e2e:workbench": "node tests/e2e/province-workbench.cjs",
    "test:e2e:assistant": "node tests/e2e/general-assistant.cjs",
    "test:e2e:province-relief": "node tests/e2e/province-relief.cjs",
    "test:e2e:operations": "node tests/e2e/operations-supervision.cjs",
    "test:e2e:safety": "node tests/e2e/safety-supervision.cjs",
    "test:e2e:city-workbench": "node tests/e2e/regulatory-workbench.cjs",
    "test:e2e:city-cockpit": "node tests/e2e/city-cockpit.cjs",
    "test:e2e:road-areas": "node tests/e2e/road-operation-areas.cjs",
    "test:api:city-analytics": "node tests/api/city-analytics-api.cjs",
    "test:e2e:city-analytics": "node tests/e2e/city-analytics.cjs",
    "db:road-corridors:plan": "node prisma/convert-operation-road-corridors.cjs --plan",
    "db:road-corridors:apply": "node prisma/convert-operation-road-corridors.cjs --apply",
    "db:road-corridors:verify": "node prisma/convert-operation-road-corridors.cjs --verify"
  },
  "devDependencies": {
    "@prisma/client": "6.15.0",
    "@turf/buffer": "7.2.0",
    "concurrently": "9.2.1",
    "playwright": "1.62.0",
    "prisma": "6.15.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
