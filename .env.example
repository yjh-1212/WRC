DATABASE_URL="file:../data/regulatory.db"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-another-at-least-32-random-characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=8080
WEB_ORIGIN="http://localhost:5173"

# 可选。种子数据拉高德 Web 服务（地点搜索 / 驾车路径 / 逆地理 AOI）时使用。
# 不填则使用高德官方公开测试 Web Key。JSAPI Key 不能替代 Web 服务 Key。
# AMAP_WEB_KEY=""
# AMAP_WEB_APPNAME="wurenche-seed"

# Web 地图变量位于 apps/web/.env.example。
