  @@index([workspaceId, createdAt])
}

model ApplicationMaterial {
  application CityApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  id            String    @id @default(cuid())
  applicationId String
  originalName  String
  mimeType      String
  size          Int
  storageName   String    @unique
  sha256        String
  revision      Int       @default(1)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([applicationId, deletedAt])
}

model ProvinceMatter {
  id              String               @id @default(cuid())
  businessNo      String               @unique
  kind            String
  template        String               @default("STANDARD")
  leadWorkspaceId String?
  checklistJson   String               @default("[]")
  relatedType     String?
  relatedId       String?
  title           String
  description     String
  level           String               @default("MEDIUM")
  status          String               @default("DRAFT")
  dueAt           DateTime?
  basis           String?
  resourceIdsJson String               @default("[]")
  logsJson        String               @default("[]")
  createdById     String
  createdByName   String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  assignments     ProvinceAssignment[]

  @@index([kind, status, dueAt])
  @@index([template, status])
  @@index([relatedType, relatedId])
}

model ProvinceAssignment {
  id            String         @id @default(cuid())
  matterId      String
  matter        ProvinceMatter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  workspaceId   String
  status        String         @default("WAITING")
  feedback      String?
  evidenceNote  String?
  reportJson    String?
  respondedAt   DateTime?
  submittedAt   DateTime?
  reviewComment String?
  closedAt      DateTime?
  updatedAt     DateTime       @updatedAt

  @@unique([matterId, workspaceId])
  @@index([workspaceId, status])
}

model ProvincePilot {
  id              String    @id @default(cuid())
  workspaceId     String    @unique
  stage           String    @default("PREPARING")
  responsibleName String
  planDate        DateTime?
  summary         String
  reviewComment   String?
  logsJson        String    @default("[]")
  updatedAt       DateTime  @updatedAt
}

model ProvinceResource {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  kind         String
  status       String   @default("AVAILABLE")
  capacity     Int      @default(1)
  contactName  String?
  contactPhone String?
  conditions   String?
  updatedAt    DateTime @updatedAt

  @@index([workspaceId, status, kind])
}

model CockpitAppearance {
  id        String   @id
  revision  Int      @default(0)
  payload   String   @default("{}")
  updatedAt DateTime @default(now()) @updatedAt
}

model AgentConversation {
  id           String      @id @default(cuid())
  userId       String
  workspaceId  String?
  enterpriseId String?
  agentCode    String
  title        String
  pagePath     String      @default("")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  turns        AgentTurn[]

  @@index([userId, updatedAt])
}

model AgentTurn {
  id             String            @id @default(cuid())
  conversationId String
  requestKey     String
  question       String
  answer         String            @default("")
  status         String            @default("PENDING")
  sourcesJson    String            @default("[]")
  factsJson      String            @default("{}")
  scopeKey       String
  mode           String            @default("MODEL")
  error          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, requestKey])
  @@index([conversationId, createdAt])
}

model ProvinceDutyEvaluation {
  id            String    @id @default(cuid())
  workspaceId   String
  period        String
  status        String    @default("DRAFT")
  score         Float
  grade         String
  breakdownJson String    @default("{}")
  conclusion    String?
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  @@unique([workspaceId, period])
  @@index([period, status])
}
