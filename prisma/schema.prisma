  name         String
  level        String
  parentCode   String?
  longitude    Float
  latitude     Float
  cameraHeight Float?
  status       String                  @default("ACTIVE")
  sortOrder    Int                     @default(0)
  sourceName   String
  reportedAt   DateTime
