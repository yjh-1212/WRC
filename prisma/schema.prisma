generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  workspaceId String?

  id                      String                   @id @default(cuid())
  code                    String                   @unique
  name                    String
  status                  String                   @default("ACTIVE")
  parentId                String?
  parent                  Organization?            @relation("OrganizationTree", fields: [parentId], references: [id])
  children                Organization[]           @relation("OrganizationTree")
  users                   User[]
  enterprises             Enterprise[]
  vehicles                Vehicle[]
  licenses                VehicleLicense[]
  admissionApplications   AdmissionApplication[]
  operationRecords        OperationRecord[]
  operationRegions        OperationRegion[]
  safetyAlerts            SafetyAlert[]
  electronicFences        ElectronicFence[]
  accidents               Accident[]
  violations              Violation[]
  offlineEvents           OfflineEvent[]
  emergencyTasks          EmergencyTask[]
  evaluationIndicators    EvaluationIndicator[]
  evaluationTasks         EvaluationTask[]
  enterpriseEvaluations   EnterpriseEvaluation[]
  evaluationAppeals       EvaluationAppeal[]
  accidentReconstructions AccidentReconstruction[]
  regulatoryReports       RegulatoryReport[]
  deliveryOrders          DeliveryOrder[]
  safetyOperators         SafetyOperator[]
  regulatoryInspections   RegulatoryInspection[]
  businessRules           BusinessRule[]
  creditAccounts          CreditAccount[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([parentId])
  @@index([workspaceId])
}

model Enterprise {
  id                      String                    @id @default(cuid())
  businessNo              String                    @unique
  name                    String
  creditCode              String                    @unique
  type                    String                    @default("OPERATOR")
  status                  String                    @default("ACTIVE")
  legalRepresentative     String?
  contactName             String?
  contactPhone            String?
  registeredAddress       String?
  organizationId          String
  organization            Organization              @relation(fields: [organizationId], references: [id])
  users                   User[]
  vehicles                Vehicle[]
  licenses                VehicleLicense[]
  qualifications          EnterpriseQualification[]
  admissionApplications   AdmissionApplication[]
  operationRecords        OperationRecord[]
  operationRegions        OperationRegion[]
  safetyAlerts            SafetyAlert[]
  electronicFences        ElectronicFence[]
  accidents               Accident[]
  violations              Violation[]
  offlineEvents           OfflineEvent[]
  emergencyTasks          EmergencyTask[]
  enterpriseEvaluations   EnterpriseEvaluation[]
  evaluationAppeals       EvaluationAppeal[]
  accidentReconstructions AccidentReconstruction[]
  regulatoryReports       RegulatoryReport[]
  deliveryOrders          DeliveryOrder[]
  safetyOperators         SafetyOperator[]
  interfaceConfigs        ExternalInterfaceConfig[]
  regulatoryInspections   RegulatoryInspection[]
  creditAccounts          CreditAccount[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([organizationId])
  @@index([status])
}

model Manufacturer {
  id           String         @id @default(cuid())
  businessNo   String         @unique
  name         String         @unique
  shortName    String?
  creditCode   String?        @unique
  contactName  String?
  contactPhone String?
  address      String?
  status       String         @default("ACTIVE")
  deletedAt    DateTime?
  models       VehicleModel[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, deletedAt])
}

model VehicleModel {
  id             String       @id @default(cuid())
  businessNo     String       @unique
  modelCode      String       @unique
  name           String
  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  vehicleType    String       @default("DELIVERY")
  autonomyLevel  String       @default("L4")
  maxSpeed       Int
  ratedRange     Int
  loadCapacity   Int
  dimensions     String?
  status         String       @default("ACTIVE")
  deletedAt      DateTime?
  vehicles       Vehicle[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([manufacturerId, name])
  @@index([manufacturerId, status])
  @@index([status, deletedAt])
}

model Vehicle {
  id                  String                        @id @default(cuid())
  businessNo          String                        @unique
  vin                 String                        @unique
  deviceNo            String                        @unique
  name                String
  unifiedCode         String?                       @unique
  unifiedCodeIssuedAt DateTime?
  vehicleType         String                        @default("DELIVERY")
  operationScene      String                        @default("URBAN_DELIVERY")
  upperEquipment      String?
  modelId             String
  model               VehicleModel                  @relation(fields: [modelId], references: [id])
  enterpriseId        String
  enterprise          Enterprise                    @relation(fields: [enterpriseId], references: [id])
  organizationId      String
  organization        Organization                  @relation(fields: [organizationId], references: [id])
  color               String?
  manufactureDate     DateTime?
  serviceStartDate    DateTime?
  status              String                        @default("ACTIVE")
  onlineStatus        String                        @default("OFFLINE")
  deletedAt           DateTime?
  licenses            VehicleLicense[]
  archive             VehicleArchive?
  applicationVehicles AdmissionApplicationVehicle[]
  realtimeStatus      VehicleRealtimeStatus?
  operationRecords    OperationRecord[]
  trackPoints         VehicleTrackPoint[]
  observations        VehicleObservation[]
  operationRegions    OperationRegionVehicle[]
  onlineDailyMetrics  VehicleOnlineDaily[]
  safetyAlerts        SafetyAlert[]
  fenceAssignments    ElectronicFenceVehicle[]
  fenceTriggers       FenceTrigger[]
  accidents           Accident[]
  violations          Violation[]
  offlineEvents       OfflineEvent[]
  deliveryOrders      DeliveryOrder[]
  operatorAssignments SafetyOperatorVehicle[]
  creditAccounts      CreditAccount[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@index([enterpriseId, status])
  @@index([organizationId, status])
  @@index([modelId])
  @@index([onlineStatus])
  @@index([deletedAt])
}

model SafetyOperator {
  id                String                  @id @default(cuid())
  businessNo        String                  @unique
  name              String
  idNumberMasked    String
  phone             String?
  enterpriseId      String
  enterprise        Enterprise              @relation(fields: [enterpriseId], references: [id])
  organizationId    String
  organization      Organization            @relation(fields: [organizationId], references: [id])
  qualificationType String                  @default("REMOTE_SAFETY_OPERATOR")
  qualificationNo   String?
  trainingCompleted Boolean                 @default(false)
  appliedAt         DateTime                @default(now())
  reviewedAt        DateTime?
  expiresAt         DateTime?
  status            String                  @default("PENDING")
  reviewComment     String?
  shiftStart        String?
  shiftEnd          String?
  onDuty            Boolean                 @default(false)
  vehicles          SafetyOperatorVehicle[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([enterpriseId, status])
  @@index([organizationId, status])
}

model SafetyOperatorVehicle {
  operatorId String
  vehicleId  String
  operator   SafetyOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  vehicle    Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignedAt DateTime       @default(now())

  @@id([operatorId, vehicleId])
  @@index([vehicleId])
}

model ExternalInterfaceConfig {
  id               String     @id @default(cuid())
  businessNo       String     @unique
  name             String
  enterpriseId     String
  enterprise       Enterprise @relation(fields: [enterpriseId], references: [id])
  interfaceType    String
  endpoint         String
  authType         String     @default("SIGNATURE")
  protocolVersion  String     @default("1.0")
  contactName      String?
  contactPhone     String?
  capabilitiesJson String     @default("[]")
  environment      String     @default("TEST")
  status           String     @default("UNVERIFIED")
  lastTestAt       DateTime?
  lastTestResult   String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([enterpriseId, interfaceType])
  @@index([status])
}

model RegulatoryInspection {
  id                 String       @id @default(cuid())
  businessNo         String       @unique
  title              String
  inspectionType     String       @default("ROUTINE")
  enterpriseId       String
  enterprise         Enterprise   @relation(fields: [enterpriseId], references: [id])
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  inspectorName      String
  scheduledAt        DateTime
  completedAt        DateTime?
  status             String       @default("PLANNED")
  result             String?
  issueCount         Int          @default(0)
  rectificationDueAt DateTime?
  rectification      String?
  reviewComment      String?
  materialsJson      String       @default("[]")
  historyJson        String       @default("[]")
  version            Int          @default(1)
  issues             InspectionIssue[]
  closedAt           DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([enterpriseId, status, scheduledAt])
  @@index([organizationId, status, scheduledAt])
}

model BusinessRule {
  id             String       @id @default(cuid())
  businessNo     String       @unique
  category       String
  name           String
  version        Int          @default(1)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  valueJson      String
  status         String       @default("DRAFT")
  effectiveAt    DateTime?
  publishedBy    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, category, version])
  @@index([category, status])
}

model CreditAccount {
  id             String        @id @default(cuid())
  businessNo     String        @unique
  subjectType    String
  enterpriseId   String?
  enterprise     Enterprise?   @relation(fields: [enterpriseId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?      @relation(fields: [vehicleId], references: [id])
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  initialScore   Int           @default(100)
  currentScore   Int           @default(100)
  grade          String        @default("A")
  status         String        @default("ACTIVE")
  entries        CreditEntry[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([subjectType, enterpriseId, vehicleId])
  @@index([organizationId, grade])
}

model CreditEntry {
  id               String        @id @default(cuid())
  businessNo       String        @unique
  accountId        String
  account          CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  eventType        String
  severity         String
  scoreChange      Int
  scoreAfter       Int
  reason           String
  sourceType       String?
  sourceId         String?
  status           String        @default("CONFIRMED")
  confirmedBy      String?
  confirmedAt      DateTime?
  repairEligibleAt DateTime?
  repairedAt       DateTime?
  sourceKey        String?       @unique
  ruleSnapshotJson String        @default("{}")
  historyJson      String        @default("[]")
  repairNote       String?
  repairedBy       String?
  repairMaterialsJson String     @default("[]")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([accountId, createdAt])
  @@index([status, repairEligibleAt])
}

model VehicleLicense {
  id                  String                 @id @default(cuid())
  businessNo          String                 @unique
  licenseNo           String                 @unique
  vehicleId           String
  vehicle             Vehicle                @relation(fields: [vehicleId], references: [id])
  enterpriseId        String
  enterprise          Enterprise             @relation(fields: [enterpriseId], references: [id])
  organizationId      String
  organization        Organization           @relation(fields: [organizationId], references: [id])
  issuedAt            DateTime
  expiresAt           DateTime
  status              String                 @default("VALID")
  remark              String?
  licenseType         String                 @default("LEGACY")
  conditionsJson      String                 @default("{}")
  historyJson         String                 @default("[]")
  sourceApplicationId String?
  version             Int                    @default(1)
  renewalApplications AdmissionApplication[] @relation("RenewalTargetLicense")
  approvalResults     ApprovalResult[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([vehicleId, status])
  @@index([enterpriseId, status])
  @@index([organizationId])
  @@index([expiresAt])
}

model VehicleArchive {
  id              String    @id @default(cuid())
  archiveNo       String    @unique
  vehicleId       String    @unique
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  registeredAt    DateTime  @default(now())
  exitedAt        DateTime?
  lifecycleStatus String    @default("IN_SERVICE")
  remark          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([lifecycleStatus])
}

model EnterpriseQualification {
  id                String     @id @default(cuid())
  businessNo        String     @unique
  enterpriseId      String
  enterprise        Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  qualificationType String
  certificateNo     String     @unique
  issuedBy          String
  issuedAt          DateTime
  expiresAt         DateTime
  status            String     @default("VALID")
  attachmentUrl     String?
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([enterpriseId, status])
  @@index([expiresAt])
  @@index([deletedAt])
}

model User {
  workspaceId  String?
  accountLevel String  @default("CITY")
  authVersion  Int     @default(0)

  id                     String                 @id @default(cuid())
  username               String                 @unique
  passwordHash           String
  displayName            String
  phone                  String?
  email                  String?
  status                 String                 @default("ACTIVE")
  portal                 String                 @default("REGULATORY")
  organizationId         String?
  enterpriseId           String?
  organization           Organization?          @relation(fields: [organizationId], references: [id])
  enterprise             Enterprise?            @relation(fields: [enterpriseId], references: [id])
  roles                  UserRole[]
  refreshTokens          RefreshToken[]
  loginLogs              LoginLog[]
  auditLogs              AuditLog[]
  admissionApplications  AdmissionApplication[] @relation("ApplicationApplicant")
  handledApprovalTasks   ApprovalTask[]         @relation("TaskHandler")
  approvalHistories      ApprovalHistory[]      @relation("HistoryActor")
  assignedSafetyAlerts   SafetyAlert[]          @relation("AlertResponsible")
  reportedAccidents      Accident[]             @relation("AccidentReporter")
  assignedEmergencyTasks EmergencyTask[]        @relation("EmergencyAssignee")
  emergencyTaskLogs      EmergencyTaskLog[]     @relation("EmergencyLogActor")
  lastLoginAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([organizationId])
  @@index([enterpriseId])
  @@index([status])
  @@index([workspaceId])
}

model Role {
  workspaceId String?

  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  portal      String           @default("REGULATORY")
  status      String           @default("ACTIVE")
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([workspaceId])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  module      String
  description String?
  roles       RolePermission[]
  menus       Menu[]
  createdAt   DateTime         @default(now())
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Menu {
  id             String      @id @default(cuid())
  code           String      @unique
  name           String
  path           String
  icon           String?
  portal         String
  orderNo        Int         @default(0)
  parentId       String?
  permissionCode String?
  permission     Permission? @relation(fields: [permissionCode], references: [code])
  parent         Menu?       @relation("MenuTree", fields: [parentId], references: [id])
  children       Menu[]      @relation("MenuTree")
  status         String      @default("ACTIVE")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([portal, orderNo])
  @@index([parentId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username  String
  ip        String?
  userAgent String?
  success   Boolean
  message   String?
  createdAt DateTime @default(now())

  @@index([username, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  roleNames      String?
  organizationId String?
  enterpriseId   String?
  module         String
  objectType     String
  objectId       String?
  action         String
  result         String
  ip             String?
  detail         String?
  createdAt      DateTime @default(now())

  @@index([module, createdAt])
  @@index([enterpriseId, createdAt])
}

model ProcessDefinition {
  workspaceId String?

  id              String                  @id @default(cuid())
  businessNo      String                  @unique
  code            String                  @unique
  name            String
  applicationType String
  version         Int                     @default(1)
  status          String                  @default("DRAFT")
  description     String?
  nodes           ProcessNodeDefinition[]
  instances       ProcessInstance[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([applicationType, status])
  @@index([workspaceId])
}

model ProcessNodeDefinition {
  id                  String            @id @default(cuid())
  processDefinitionId String
  processDefinition   ProcessDefinition @relation(fields: [processDefinitionId], references: [id], onDelete: Cascade)
  nodeCode            String
  name                String
  orderNo             Int
  approvalRoleCode    String
  timeLimitHours      Int               @default(48)
  countersignMode     String            @default("ANY")
  canReturn           Boolean           @default(true)
  tasks               ApprovalTask[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([processDefinitionId, nodeCode])
  @@unique([processDefinitionId, orderNo])
  @@index([approvalRoleCode])
}

model AdmissionApplication {
  id                     String                        @id @default(cuid())
  businessNo             String                        @unique
  applicationType        String
  title                  String
  applicantUserId        String
  applicantUser          User                          @relation("ApplicationApplicant", fields: [applicantUserId], references: [id])
  enterpriseId           String?
  enterprise             Enterprise?                   @relation(fields: [enterpriseId], references: [id])
  organizationId         String
  organization           Organization                  @relation(fields: [organizationId], references: [id])
  status                 String                        @default("DRAFT")
  currentNodeName        String?
  submittedAt            DateTime?
  completedAt            DateTime?
  enterpriseNameSnapshot String?
  creditCodeSnapshot     String?
  legalRepresentative    String?
  contactName            String?
  contactPhone           String?
  registeredAddress      String?
  operationPlan          String?
  qualificationSummary   String?
  roadTestStartAt        DateTime?
  roadTestEndAt          DateTime?
  roadTestRoute          String?
  testPlan               String?
  safetyMeasures         String?
  targetLicenseId        String?
  targetLicense          VehicleLicense?               @relation("RenewalTargetLicense", fields: [targetLicenseId], references: [id])
  requestedExpiresAt     DateTime?
  renewalReason          String?
  detailsJson            String                        @default("{}")
  materialsJson          String                        @default("[]")
  vehicles               AdmissionApplicationVehicle[]
  processInstances       ProcessInstance[]
  approvalTasks          ApprovalTask[]
  approvalHistories      ApprovalHistory[]
  result                 ApprovalResult?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  @@index([applicationType, status])
  @@index([enterpriseId, status])
  @@index([organizationId, status])
  @@index([applicantUserId, createdAt])
}

model AdmissionApplicationVehicle {
  applicationId String
  vehicleId     String
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  vehicle       Vehicle              @relation(fields: [vehicleId], references: [id])
  createdAt     DateTime             @default(now())

  @@id([applicationId, vehicleId])
  @@index([vehicleId])
}

model ProcessInstance {
  id                  String               @id @default(cuid())
  businessNo          String               @unique
  applicationId       String
  application         AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  processDefinitionId String
  processDefinition   ProcessDefinition    @relation(fields: [processDefinitionId], references: [id])
  status              String               @default("RUNNING")
  currentNodeOrder    Int                  @default(1)
  startedAt           DateTime             @default(now())
  completedAt         DateTime?
  tasks               ApprovalTask[]
  histories           ApprovalHistory[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([applicationId, createdAt])
  @@index([status, currentNodeOrder])
}

model ApprovalTask {
  id                String                @id @default(cuid())
  businessNo        String                @unique
  applicationId     String
  application       AdmissionApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  processInstanceId String
  processInstance   ProcessInstance       @relation(fields: [processInstanceId], references: [id], onDelete: Cascade)
  nodeDefinitionId  String
  nodeDefinition    ProcessNodeDefinition @relation(fields: [nodeDefinitionId], references: [id])
  assigneeRoleCode  String
  handlerUserId     String?
  handlerUser       User?                 @relation("TaskHandler", fields: [handlerUserId], references: [id])
  status            String                @default("PENDING")
  dueAt             DateTime
  handledAt         DateTime?
  comment           String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([assigneeRoleCode, status, dueAt])
  @@index([applicationId, createdAt])
  @@index([processInstanceId, status])
}

model ApprovalHistory {
  id                String               @id @default(cuid())
  applicationId     String
  application       AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  processInstanceId String?
  processInstance   ProcessInstance?     @relation(fields: [processInstanceId], references: [id], onDelete: SetNull)
  taskId            String?
  actorUserId       String?
  actorUser         User?                @relation("HistoryActor", fields: [actorUserId], references: [id])
  actorName         String
  action            String
  fromStatus        String?
  toStatus          String
  nodeName          String?
  comment           String?
  snapshotJson      String?
  createdAt         DateTime             @default(now())

  @@index([applicationId, createdAt])
  @@index([processInstanceId, createdAt])
}

model ApprovalResult {
  id               String               @id @default(cuid())
  businessNo       String               @unique
  applicationId    String               @unique
  application      AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resultType       String
  status           String               @default("VALID")
  documentNo       String               @unique
  licenseId        String?
  license          VehicleLicense?      @relation(fields: [licenseId], references: [id])
  operationRegions OperationRegion[]
  issuedAt         DateTime             @default(now())
  validFrom        DateTime?
  validTo          DateTime?
  content          String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([resultType, status])
  @@index([licenseId])
}

model VehicleRealtimeStatus {
  id              String   @id @default(cuid())
  vehicleId       String   @unique
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  longitude       Float
  latitude        Float
  speed           Float    @default(0)
  heading         Float    @default(0)
  battery         Int
  drivingState    String   @default("PARKED")
  autonomousState String   @default("STANDBY")
  signalStrength  Int      @default(100)
  mileageToday    Float    @default(0)
  locationTime    DateTime
  heartbeatAt     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([drivingState, heartbeatAt])
  @@index([heartbeatAt])
}

model OperationRegion {
  id               String                   @id @default(cuid())
  businessNo       String                   @unique
  name             String
  regionType       String                   @default("OPERATION")
  enterpriseId     String?
  enterprise       Enterprise?              @relation(fields: [enterpriseId], references: [id])
  organizationId   String
  organization     Organization             @relation(fields: [organizationId], references: [id])
  approvalResultId String?
  approvalResult   ApprovalResult?          @relation(fields: [approvalResultId], references: [id])
  polygonJson      String
  validFrom        DateTime
  validTo          DateTime?
  status           String                   @default("ACTIVE")
  approvalStatus   String                   @default("APPROVED")
  speedLimit       Int                      @default(20)
  allowedHours     String?
  ruleDescription  String?
  historyJson      String                   @default("[]")
  vehicles         OperationRegionVehicle[]
  records          OperationRecord[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([enterpriseId, status])
  @@index([organizationId, status])
  @@index([approvalStatus])
}

model OperationRegionVehicle {
  regionId   String
  vehicleId  String
  region     OperationRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  vehicle    Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
