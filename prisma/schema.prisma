  runningVehicles      Int
  operatingEnterprises Int
  mileageToday         Float
  riskEvents           Int
  majorEvents          Int
  unresolvedMajor      Int
  dataQualityRate      Float
  deliveryVehicles     Int           @default(0)
  sanitationVehicles   Int           @default(0)
  patrolVehicles       Int           @default(0)
  retailVehicles       Int           @default(0)
  shuttleVehicles      Int           @default(0)
  vehicleMetricsJson   String?
  sourceName           String
  sourceType           String        @default("REGULATORY_REPORT")
  reportedAt           DateTime
  createdAt            DateTime      @default(now())

  @@unique([regionId, capturedAt])
  @@index([capturedAt])
}

